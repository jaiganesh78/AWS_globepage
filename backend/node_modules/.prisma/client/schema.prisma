datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  flag         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  regions      Region[]

  @@index([displayOrder])
}

model Region {
  id                        String @id @default(cuid())
  awsRegionCode             String @unique
  name                      String
  regionCode                String
  flag                      String
  latitude                  Float
  longitude                 Float
  infrastructureDescription String
  availabilityZones         Int
  launchYear                Int
  primaryLocation           String
  compliance                String
  totalServices             String
  aimlServices              String
  analyticsServices         String
  networkingServices        String
  edgeLocations             String
  directConnect             String
  reach                     String
  latency                   String

  // Relationships
  categoryId String
  category   Category        @relation(fields: [categoryId], references: [id])
  services   RegionService[]
  benefits   RegionBenefit[]

  // Soft deletion
  isDeleted Boolean @default(false)

  // Audit fields
  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([awsRegionCode])
  @@index([categoryId])
  @@index([isDeleted])
}

model RegionService {
  id       String @id @default(cuid())
  name     String
  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)
}

model RegionBenefit {
  id          String @id @default(cuid())
  description String
  regionId    String
  region      Region @relation(fields: [regionId], references: [id], onDelete: Cascade)
}
