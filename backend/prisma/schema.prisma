datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  flag         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  regions      Region[]

  @@index([displayOrder])
  @@index([isDeleted])
}

model Region {
  id                        String   @id @default(cuid())
  awsRegionCode             String   @unique
  name                      String
  regionCode                String
  flag                      String
  flagUrl                   String?
  displayOrder              Int      @default(0)
  latitude                  Float
  longitude                 Float
  infrastructureDescription String
  availabilityZones         Int
  launchYear                Int
  primaryLocation           String
  compliance                String
  totalServices             String
  aimlServices              String
  analyticsServices         String
  networkingServices        String
  edgeLocations             String
  directConnect             String
  reach                     String
  latency                   String

  // Relationships
  categoryId                String
  category                  Category @relation(fields: [categoryId], references: [id])
  services                  RegionService[]
  benefits                  RegionBenefit[]
  aiCapabilities            RegionAiCapability[]
  topServices               RegionTopService[]
  workloads                 RegionWorkload[]

  // Soft deletion
  isDeleted                 Boolean  @default(false)

  // Audit fields
  createdBy                 String?
  updatedBy                 String?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([awsRegionCode])
  @@index([categoryId])
  @@index([isDeleted])
}

model RegionService {
  id       String @id @default(cuid())
  name     String
  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, name])
}

model RegionBenefit {
  id          String @id @default(cuid())
  description String
  regionId    String
  region      Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, description])
}

model RegionAiCapability {
  id         String @id @default(cuid())
  capability String
  regionId   String
  region     Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, capability])
}

model RegionTopService {
  id       String @id @default(cuid())
  name     String
  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, name])
}

model RegionWorkload {
  id          String @id @default(cuid())
  description String
  regionId    String
  region      Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, description])
}

model AWSServiceCategory {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  iconUrl      String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  services     AWSService[]

  @@index([displayOrder])
  @@index([isDeleted])
}

model AWSService {
  id                  String   @id @default(cuid())
  serviceCode         String   @unique // e.g. "ec2", "s3"
  name                String   @unique
  slug                String   @unique
  categoryId          String
  category            AWSServiceCategory @relation(fields: [categoryId], references: [id])
  shortDescription    String
  fullDescription     String
  characteristics     String[]
  features            String[]
  useCases            String[]
  pricingModels       String[]
  relatedServices     Json     // [{"slug": "amazon-ebs", "name": "Amazon EBS"}]
  iconUrl             String
  keywords            String[]
  awsDocumentationUrl String?
  isFeatured          Boolean  @default(false)
  status              String   @default("GA") // GA, Preview, Beta, Deprecated, Retired
  lastAwsUpdate       DateTime?
  comparisonTags      String[]
  displayOrder        Int      @default(0)
  isActive            Boolean  @default(true)
  isDeleted           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([categoryId])
  @@index([displayOrder])
  @@index([isDeleted])
  @@index([isFeatured])
}


