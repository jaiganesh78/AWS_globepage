datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  flag         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  regions      Region[]

  @@index([displayOrder])
  @@index([isDeleted])
}

model Region {
  id                        String   @id @default(cuid())
  awsRegionCode             String   @unique
  name                      String
  regionCode                String
  flag                      String
  flagUrl                   String?
  displayOrder              Int      @default(0)
  latitude                  Float
  longitude                 Float
  infrastructureDescription String
  availabilityZones         Int
  launchYear                Int
  primaryLocation           String
  compliance                String
  totalServices             String
  aimlServices              String
  analyticsServices         String
  networkingServices        String
  edgeLocations             String
  directConnect             String
  reach                     String
  latency                   String

  // Relationships
  categoryId                String
  category                  Category @relation(fields: [categoryId], references: [id])
  services                  RegionService[]
  benefits                  RegionBenefit[]
  aiCapabilities            RegionAiCapability[]
  topServices               RegionTopService[]
  workloads                 RegionWorkload[]

  // Soft deletion
  isDeleted                 Boolean  @default(false)

  // Audit fields
  createdBy                 String?
  updatedBy                 String?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([awsRegionCode])
  @@index([categoryId])
  @@index([isDeleted])
}

model RegionService {
  id       String @id @default(cuid())
  name     String
  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, name])
}

model RegionBenefit {
  id          String @id @default(cuid())
  description String
  regionId    String
  region      Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, description])
}

model RegionAiCapability {
  id         String @id @default(cuid())
  capability String
  regionId   String
  region     Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, capability])
}

model RegionTopService {
  id       String @id @default(cuid())
  name     String
  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, name])
}

model RegionWorkload {
  id          String @id @default(cuid())
  description String
  regionId    String
  region      Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, description])
}

